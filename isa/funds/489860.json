는  80%이며, Diversified 기업은 20%입니다. 또한 환헤지 전략을 실행하지 아니할 계획입니다.   3. 이 투자신탁은 기초지수 추종을 위하여 기초지수를 구성하는 종목 전체를 편입하는 완전복제 전략을 원칙으로 하고 있으며, 다만 집합투자업자가 추적오차 최소화 및 원활한 설명환매 대응을 위하여 대체자산(기초지수 관련 파생상품 및 기초자산 관련 집합투자증권 등)을 일부 편입할 수 있습니다.","sourceDividendYield":0.96,"sourceDividendPerShareTtm":125,"dividendMonths":"1,4,7","dividends":[],"holdings":[{"rank":1,"ticker":"JCI","name":"존슨 컨트롤스 인터내셔널","weight":9.22},{"rank":2,"ticker":"ETN","name":"이튼","weight":8.33},{"rank":3,"ticker":"PWR","name":"콴타 서비스","weight":8.23},{"rank":4,"name":"ABB LTD-REG","weight":7.68},{"rank":5,"name":"SCHNEIDER ELECTRIC SE","weight":6.93},{"rank":6,"name":"NATIONAL GRID PLC","weight":4.7},{"rank":7,"name":"E.ON SE","weight":4.59},{"rank":8,"name":"PRYSMIAN SPA","weight":3.64},{"rank":9,"name":"원화현금","weight":2.8},{"rank":10,"ticker":"HUBB","name":"허벨","weight":2.79}],"holdingsCount":null,"holdingsAsOf":null,"holdingsCollectedAt":"2026-10-27T00:42:35.855Z","holdingSearch":[{"ticker":"JCI","name":"존슨 컨트롤스 인터내셔널","weight":9.22},{"ticker":"ETN","name":"이튼","weight":8.33},{"ticker":"PWR","name":"콴타 서비스","weight":8.23},{"name":"ABB LTD-REG","weight":7.68},{"name":"SCHNEIDER ELECTRIC SE","weight":6.93},{"name":"NATIONAL GRID PLC","weight":4.7},{"name":"E.ON SE","weight":4.59},{"name":"PRYSMIAN SPA","weight":3.64},{"name":"원화현금","weight":2.8},{"ticker":"HUBB","name":"허벨","weight":2.79}],"overviewSource":"https://stock.naver.com/domestic/stock/489860","holdingsSource":"https://stock.naver.com/domestic/stock/489860","website":null,"sourceInfo":{"stockEndType":"etf","itemCode":"489860","reutersCode":"489860","stockName":"KIWOOM 글로벌전력GRID인프라","sosok":"0","closePrice":"13,040","compareToPreviousClosePrice":"65","compareToPreviousPrice":{"code":"2","text":"상승","name":"RISING"},"fluctuationsRatio":"0.50","marketStatus":"OPEN","marketStatusDetailType":"open","localTradedAt":"2026-10-27T09:42:21+09:00","tradeStopType":{"code":"1","text":"운영.Trading","name":"TRADING"},"tradableStatus":"tradable","tradableStatusCode":"ok