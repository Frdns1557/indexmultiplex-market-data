참가회사에 환매 신청할 수 없으며, 거래소의 거래 상황에 따라 동 ETF의 순자산가치와 거래가격이 다르게 형성될 수 있습니다.  상품에 대한 자세한 내용은 집합투자업자 인터넷 홈페이지(http://www.hanaroetf.com) 또는 금융감독원 전자공시시스템의 투자설명서를 통해 확인하시기 바랍니다.","sourceDividendYield":0,"sourceDividendPerShareTtm":0,"dividendMonths":null,"dividends":[],"holdings":[{"rank":1,"ticker":"MU","name":"마이크론 테크놀로지","weight":18.63},{"rank":2,"ticker":"SNDK","name":"샌디스크","weight":15.97},{"rank":3,"ticker":"STX","name":"씨게이트","weight":13.97},{"rank":4,"ticker":"WDC","name":"웨스턴 디지털","weight":12.95},{"rank":5,"ticker":"ASML","name":"ASML 홀딩 ADR","weight":7.83},{"rank":6,"ticker":"ONTO","name":"온투 이노베이션","weight":6.43},{"rank":7,"ticker":"KLAC","name":"KLA","weight":6.27},{"rank":8,"ticker":"LRCX","name":"램 리서치","weight":5.78},{"rank":9,"ticker":"SIMO","name":"실리콘 모션 테크놀로지 ADR","weight":5.67},{"rank":10,"ticker":"AMKR","name":"앰코 테크놀로지","weight":5.34}],"holdingsCount":null,"holdingsAsOf":null,"holdingsCollectedAt":"2026-10-30T00:46:53.220Z","holdingSearch":[{"ticker":"MU","name":"마이크론 테크놀로지","weight":18.63},{"ticker":"SNDK","name":"샌디스크","weight":15.97},{"ticker":"STX","name":"씨게이트","weight":13.97},{"ticker":"WDC","name":"웨스턴 디지털","weight":12.95},{"ticker":"ASML","name":"ASML 홀딩 ADR","weight":7.83},{"ticker":"ONTO","name":"온투 이노베이션","weight":6.43},{"ticker":"KLAC","name":"KLA","weight":6.27},{"ticker":"LRCX","name":"램 리서치","weight":5.78},{"ticker":"SIMO","name":"실리콘 모션 테크놀로지 ADR","weight":5.67},{"ticker":"AMKR","name":"앰코 테크놀로지","weight":5.34}],"overviewSource":"https://stock.naver.com/domestic/stock/0181B0","holdingsSource":"https://stock.naver.com/domestic/stock/0181B0","website":null,"sourceInfo":{"stockEndType":"etf","itemCode":"0181B0","reutersCode":"0181B0","stockName":"HANARO 미국AI메모리반도체TOP4+","sosok":"0","closePrice":"7,895","compareToPreviousClosePrice":"-275","compareToPreviousPrice":{"code":"5","text":"하락","name":"FALLING"},"fluctuationsRatio":"-3.37","marketStatus":"OPEN","marketStatusDetailType":"open","localTradedAt":"2026-10-30T09:46:19+09:00","tradeStopTy